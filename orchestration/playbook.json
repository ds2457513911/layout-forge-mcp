  "gates": [
    {
      "id": "G-ambiguous-src",
      "title": "输入目录歧义时不得替用户选",
      "consequence": "deny",
      "on_fail_action": "confirm",
      "detect": {
        "kind": "tool_field",
        "ref": "folder_preflight → verdict/ambiguous/action"
      },
      "evidence": [
        "verdict",
        "ambiguous",
        "pdf_files",
        "dra_files",
        "hint"
      ],
      "enforced_by": "orchestration/preflight.py::classify_folder",
      "guarded_by": [
        "eval/suites/behavior/check_behavior.py::B1"
      ]
    },
    {
      "id": "G-stale-report",
      "title": "陈旧的 checklist_report_*.json 不能当本次证据",
