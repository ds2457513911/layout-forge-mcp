{
  "schema": "layout-forge-playbook/1",
  "_meta": {
    "purpose": "规则装配表：每条规则给出「检测方式 + 后果类别 + 证据字段」，供 L3 编排层与 SKILL 查阅。",
    "updated": "2026-10-15",
    "consequence_taxonomy": {
      "deny": "违反了就不能再给结论（无对象 / 无数据 / 证据源不可信）",
      "silent": "结论会错但看不出来（数值、命名、几何、真缺陷被无声放过）",
      "recoverable": "只是提示或口径问题，可继续，但报告需注明"
    },
    "detect_kinds": {
      "rule_id": "由 services/rule_checker.py 的 _item(rule_id, ...) 产出",
      "tool_field": "由 MCP 工具返回值里的字段直接判定",
      "function": "调用某个函数/Suite 自检，看返回值或失败码",
      "suite": "跑 eval/suites/<name> 并与基线对比"
    },
    "invariants": [
      "每条规则必须同时有 detect 与 consequence，缺一不许进表",
      "与 knowledge/cases 用 rule_id 互指，不复制内容",
      "不引用自检项号：两个自检脚本没有稳定项号，机器可读的只有总数（239/222/35）"
    ],
    "generated_by": "cache/scratch/build_playbook.py（ast 抽取 _item 调用点）+ 人工核对后果类别"
  },
  "rules": [
