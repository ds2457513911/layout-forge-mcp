# ============================================================
# layout-check-mcp .gitignore
# ============================================================

# ---------- Python 构建产物 ----------
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# ---------- 虚拟环境 ----------
.venv/
venv/

# ---------- 测试 / 缓存 / 日志 ----------
marker_out/
*.log
*.log,*
.trash
mcp_timing.log
mcp-config.json
extract.log*

# ---------- 临时调试产物 ----------
_extracta_debug/
_*_out.json

# ---------- 调试脚本（本地开发用，不进仓库） ----------
Tools/debug/

# ---------- 备份 ----------
.cleanup_backup/

# ---------- Allegro 生成物 ----------
signoise.run/
*.dra.orig
*.dra.orig.*
*.lck
AUTOSAVE.*
allegro.jrl*
master.tag
devices.dml
dbdoctor.log
padstack_editor.jrl

# ---------- 客户资料（禁止上传） ----------
# Data/

# Tools/ 整体不上传：里面有 e2e 脚本、探针、客户料号。
# 但一键部署（deploy\setup_agent.py）必须用到下面这几个，单独放行。
# ★ 注意不能写 "Tools/" 目录级忽略 —— 那样里面的 ! 例外一律失效。
Tools/*
!Tools/install_skillbridge.py
!Tools/selfcheck_geometry.py
!Tools/selfcheck_skill_syntax.py

# 含客户料号 / 本机绝对路径，明确排除
Tools/e2e_*.py
Tools/dump_*.py
Tools/probe_*.py
Tools/online_calibrate.py
Tools/verify_e2e.py
Tools/collect_logs.py

# ---------- IDE / 系统 ----------
.idea/
.vscode/
.DS_Store
Thumbs.db