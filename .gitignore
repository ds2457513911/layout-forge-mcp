# ============================================================
# layout-forge-mcp .gitignore
# ============================================================

# ---------- Python 构建产物 ----------
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# ---------- 虚拟环境 ----------
.venv/
venv/

# ---------- 测试 / 缓存 / 日志 ----------
marker_out/
*.log
*.log,*
.trash
mcp_timing.log
mcp-config.json
extract.log*

# ---------- 遥测 / 评测产物（L4 / L5）----------
# eval/runs/ = 每次运行的遥测与评测产物（不进 git）；
# eval/baselines/ 相反 —— 它是「上一次被认可的行为」，必须进 git。
eval/runs/

# ---------- 临时调试产物 ----------
_extracta_debug/
_*_out.json

# ---------- 调试脚本（本地开发用，不进仓库） ----------
Tools/debug/

# ---------- 备份 ----------
.cleanup_backup/

# ---------- Allegro 生成物 ----------
signoise.run/
*.dra.orig
*.dra.orig.*
*.lck
AUTOSAVE.*
allegro.jrl*
master.tag
devices.dml
dbdoctor.log
padstack_editor.jrl

# ---------- 客户资料（禁止上传） ----------
# Data/

# Tools/ 整体不上传：里面有 e2e 脚本、探针、客户料号。
# 但一键部署（deploy\setup_agent.py）必须用到下面这几个，单独放行。
# ★ 注意不能写 "Tools/" 目录级忽略 —— 那样里面的 ! 例外一律失效。
Tools/*
!Tools/install_skillbridge.py
!Tools/selfcheck_geometry.py
!Tools/selfcheck_skill_syntax.py
!Tools/benchmark_golden.py
!Tools/mine_conventions.py

# 含客户料号 / 本机绝对路径，明确排除
Tools/e2e_*.py
Tools/dump_*.py
Tools/probe_*.py
Tools/online_calibrate.py
Tools/verify_e2e.py
Tools/collect_logs.py

# ---------- IDE / 系统 ----------
.idea/
.vscode/
.DS_Store
Thumbs.db
# ---------- 约定链路自检与对拍工具（2026-10-13） ----------
!Tools/selfcheck_conventions.py
!Tools/compare_extracta.py
!Tools/testdata/

# ---------- SKILL 真源的分层参考文件（2026-10-23） ----------
# 按 skill-creator 的 progressive disclosure 标准，footprint 技能把 SKILL.md 拆成了
# 主干 + references/*.md。这些是**技能真源的一部分**，必须进 git —— 否则跨机重建
# 只会得到 330 行的骨架 SKILL.md，6 份分层参考全部丢失（部署到三落点也带不过去）。
#
# ★ 坑：光写 `!Tools/deploy/skills/.../references/*.md` **不管用**。git 的规则是
#   「父目录一旦被排除，里面的文件无法再被重新包含」，而上面的 `Tools/*` 把
#   `Tools/deploy` 这个目录本身排除了，于是 git 根本不往里看，`!` 例外全部失效
#   （实测 `git check-ignore -v` 仍报 .gitignore:58 `Tools/*`）。
#   所以必须先把 `Tools/deploy/` 这个目录本身重新包含进来，例外才有机会生效。
# 代价是 `Tools/deploy` 内部默认不再被 `Tools/*` 覆盖，因此下面显式补回两条不该进库的：
!Tools/deploy/
Tools/deploy/.deploy_manifest.json
Tools/deploy/__pycache__/

# ---- 缓存与索引（workspace-hygiene）----
.agent-cache/
.AIREADME
__pycache__/
*.pyc
