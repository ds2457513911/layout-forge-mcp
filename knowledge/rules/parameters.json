          "note": "通孔长圆孔 22/26 件阻焊单边 0.05；与旧 2.2 的 min/max 同一口径"
        },
        {
          "form": "FORM-MASK-TH-CIRCLE",
          "value": 0.05,
          "derive_value": 0.05,
          "support": 9,
          "source": "SRC-CONV-ADJUDICATED",
          "note": "通孔圆孔 9 件阻焊单边 0.05"
        },
        {
          "form": "FORM-MASK-SMD",
          "value": 0.08,
          "derive_value": 0.05,
          "support": 195,
          "source": "SRC-LEGACY-RULES",
          "note": "SMD 语料典型值 0.08（全量 195/246 个焊盘，出处是旧阈值文件的 soldermask_expand_typical_mm）；建库口径 derive_value 仍是 0.05（改造不改变已建封装形状，票 #20）"
        }
